{
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/thunderbird-webext-browser": "^127.0.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "okidoki": "github:joendres/okidoki",
    "playwright": "^1.62.1",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0"
  },
  "dependencies": {
    "punycode": "^2.3.1"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "start": "web-ext run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "postinstall": "playwright install firefox"
  },
  "webExt": {
    "ignoreFiles": [
      "photon-components-web/index.js",
      "photon-components-web/images/arrow-grey-40-*.svg",
      "photon-components-web/images/searchfield-cancel-*.svg",
      "photon-components-web/images/open-in-new-16-*.svg",
      "**/*.license"
    ],
    "sourceDir": "src",
    "noInput": true,
    "run": {
      "firefox": "thunderbird/thunderbird",
      "firefoxProfile": "thunderbird/profile-for-debugging/",
      "devtools": true
    },
    "build": {
      "overwriteDest": true
    },
    "lint": {
      "selfHosted": true
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}