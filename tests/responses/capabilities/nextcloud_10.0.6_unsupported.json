{
  "ocs": {
    "meta": {
      "status": "ok",
      "statuscode": 100,
      "message": null
    },
    "data": {
      "version": {
        "major": 9,
        "minor": 1,
        "micro": 6,
        "string": "10.0.6",
        "edition": ""
      },
      "capabilities": {
        "core": {
          "pollinterval": 60,
          "webdav-root": "remote.php/webdav"
        },
        "files_sharing": {
          "api_enabled": true,
          "public": {
            "enabled": true,
            "password": {
              "enforced": false
            },
            "expire_date": {
              "enabled": false
            },
            "send_mail": false,
            "upload": true,
            "upload_files_drop": true
          },
          "user": {
            "send_mail": false
          },
          "resharing": true,
          "group_sharing": true,
          "federation": {
            "outgoing": true,
            "incoming": true
          }
        },
        "theming": {
          "name": "Nextcloud",
          "url": "https://nextcloud.com",
          "slogan": "a safe home for all your data",
          "color": "#0082c9"
        },
        "files": {
          "bigfilechunking": true,
          "blacklisted_files": [
            ".htaccess"
          ],
          "undelete": true,
          "versioning": true
        },
        "notifications": {
          "ocs-endpoints": [
            "list",
            "get",
            "delete"
          ]
        }
      }
    }
  }
}
